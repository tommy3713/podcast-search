# Local dev: copy to .env.local (gitignored). Use dev-only keys, never the production ones:
# an OpenAI "gooaye-dev" project key with a low budget, a separate Telegram dev bot, and no R2.
# On the VPS these live in /opt/gooaye/worker.env (chmod 600), loaded via env_file, and
# compose sets APP_ENV=production. Without it (any local run) backups are skipped and
# Telegram messages are marked DEV.

GROQ_API_KEY=
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=          # a dev bot from @BotFather; leave empty to print notifications to stdout
TELEGRAM_CHAT_ID=

# DB_PATH=data/app.db
# SUMMARY_MODEL=gpt-5.5
# SITE_URL=https://example.com  # adds an episode link to the "went live" notification

# Web (on the VPS: /opt/gooaye/web.env). Never prefix secrets with NEXT_PUBLIC_.
# OPENAI_API_KEY above is shared locally; production uses a separate web-only key.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=             # openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3005
# ASK_MODEL=gpt-5.4-mini

# Production only: worker backups to Cloudflare R2 (token scoped to this one bucket,
# Object Read & Write). Leave empty locally.
# Add a lifecycle rule on the bucket to delete objects under backups/ after 30 days.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Production only: Healthchecks.io ping URLs (https://hc-ping.com/<uuid>). Leave empty locally.
# Heartbeat: period 30 min, grace 60 min (pinged every 30 min unless a job has run over 2 h).
# Backup: period 1 day, grace 1 hour (pinged after the 03:00 nightly; /fail on a failed or
# suspicious backup, a drop in live episodes or a nearly full disk).
HC_HEARTBEAT_URL=
HC_BACKUP_URL=
