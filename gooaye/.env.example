# Local dev: copy to .env.local (gitignored). Use low-limit keys, not the production ones.
# On the VPS these live in /opt/gooaye/worker.env (chmod 600), loaded via env_file.

GROQ_API_KEY=
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=          # optional locally; without it notifications print to stdout
TELEGRAM_CHAT_ID=

# DB_PATH=data/app.db
# SUMMARY_MODEL=gpt-5.5
# SITE_URL=https://example.com  # adds an episode link to the "went live" notification

# Web (on the VPS: /opt/gooaye/web.env). Never prefix secrets with NEXT_PUBLIC_.
# OPENAI_API_KEY above is shared locally; production uses a separate web-only key.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=             # openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3005
# ASK_MODEL=gpt-5.4-mini
