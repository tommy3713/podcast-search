{
  "name": "gooaye",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "DB_PATH=${DB_PATH:-data/dev.db} next dev -p 3005",
    "build": "next build",
    "start": "next start",
    "worker": "tsx --env-file-if-exists=.env.local worker/main.ts",
    "dev:seed": "tsx scripts/dev-seed.ts data/dev.db",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "aws4fetch": "1.0.20",
    "better-sqlite3": "13.0.3",
    "fast-xml-parser": "5.11.2",
    "next": "16.4.1",
    "next-auth": "4.24.15",
    "openai": "7.34.0",
    "opencc-js": "1.4.2",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sqlite-vec": "0.1.9",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
